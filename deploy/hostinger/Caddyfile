{
  email admin@mkt88.my
}

mkt88.my, www.mkt88.my {
  # Android WebView can leave a gzip/chunked main document in the loading
  # state forever after a page navigation. The document proxy buffers HTML and
  # supplies an exact Content-Length; normal browsers keep their existing path.
  @mkt_android header User-Agent *MKT88Android*
  handle @mkt_android {
    reverse_proxy 127.0.0.1:3001
  }
  handle {
    encode zstd gzip
    reverse_proxy 127.0.0.1:3000
  }
}
